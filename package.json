{
  "name": "@hyperttp/core",
  "version": "3.0.5",
  "description": "Protocol-agnostic client/server execution core with pluggable protocols, transports and client policies",
  "keywords": [
    "browser",
    "bun",
    "client",
    "client-server",
    "deno",
    "fetch",
    "high-performance",
    "http",
    "hyperttp",
    "isomorphic",
    "orchestration",
    "plugin",
    "protocol",
    "rest",
    "server",
    "transport",
    "undici"
  ],
  "homepage": "https://github.com/IT-IF-OR/hyperttp-core#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-core/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src tests vitest.config.ts",
    "lint:fix": "oxlint src tests vitest.config.ts --fix",
    "format": "oxfmt src tests vitest.config.ts",
    "format:check": "oxfmt src tests vitest.config.ts --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts",
    "pub": "d-publish",
    "dist": "d-dist",
    "build": "tsc && esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@hyperttp/types": "^0.5.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@hyperttp/protocol-rest": "^0.1.1"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
