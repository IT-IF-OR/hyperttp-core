{
  "name": "@hyperttp/core",
  "version": "2.0.0",
  "description": "Protocol-agnostic client/server execution core with pluggable protocols, transports and client policies",
  "keywords": [
    "browser",
    "bun",
    "client",
    "client-server",
    "deno",
    "fetch",
    "high-performance",
    "http",
    "hyperttp",
    "isomorphic",
    "orchestration",
    "plugin",
    "protocol",
    "rest",
    "server",
    "transport",
    "undici"
  ],
  "homepage": "https://github.com/IT-IF-OR/hyperttp-core#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-core/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js"
    }
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "release:npm": "d-publish",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src tests vitest.config.ts",
    "lint:fix": "oxlint src tests vitest.config.ts --fix",
    "format": "oxfmt src tests vitest.config.ts",
    "format:check": "oxfmt src tests vitest.config.ts --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.2",
    "@hyperttp/types": "^0.3.0",
    "@types/bun": "^1.4.0",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.2.0",
    "chalk": "^6.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
