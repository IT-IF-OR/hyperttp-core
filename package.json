{
  "name": "@hyperttp/core",
  "version": "3.1.2",
  "description": "Protocol-agnostic client/server execution core with pluggable protocols, transports and client policies",
  "keywords": [
    "browser",
    "bun",
    "client",
    "client-server",
    "deno",
    "fetch",
    "high-performance",
    "http",
    "hyperttp",
    "isomorphic",
    "orchestration",
    "plugin",
    "protocol",
    "rest",
    "server",
    "transport",
    "undici"
  ],
  "homepage": "https://github.com/IT-IF-OR/hyperttp-core#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-core/issues"
  },
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "oxlint src tests vitest.config.ts",
    "lint:fix": "oxlint src tests vitest.config.ts --fix",
    "format": "oxfmt src tests vitest.config.ts",
    "format:check": "oxfmt src tests vitest.config.ts --check",
    "test": "vitest run",
    "test:artifact": "node scripts/check-vite-ignore.mjs",
    "test:package": "node scripts/pack-consumer-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts",
    "pub": "d-publish",
    "dist": "d-dist",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "clean:maps": "node --input-type=module -e 'import { readdirSync, rmSync } from \"node:fs\"; import { join } from \"node:path\"; const walk = dir => { for (const entry of readdirSync(dir, { withFileTypes: true })) { const path = join(dir, entry.name); if (entry.isDirectory()) walk(path); else if (entry.isFile() && path.endsWith(\".map\")) rmSync(path); } }; walk(\"dist\");'",
    "d-esbuild": "esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify",
    "build": "npm run clean && tsc && npm run d-esbuild && d-build && npm run clean:maps"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@hyperttp/protocol-grpc": "^0.2.3",
    "@hyperttp/protocol-rest": "^0.1.3",
    "@hyperttp/transport-deno": "^0.1.3",
    "@hyperttp/transport-node": "^0.1.2",
    "@hyperttp/types": "^0.5.5",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.2.0",
    "deno": ">=2.0.0"
  }
}
